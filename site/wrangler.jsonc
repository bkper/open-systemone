{
    "$schema": "node_modules/wrangler/config-schema.json",
    // A static site: Workers static assets only, no Worker code. The redirects from www and plain
    // HTTP to https://opensystemone.org are zone settings in Cloudflare, not code: the Redirect Rule
    // "Redirect from WWW to root" and Always Use HTTPS.
    "name": "opensystemone",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./dist",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page"
    },
    "routes": [
        { "pattern": "opensystemone.org", "custom_domain": true },
        // Kept so www resolves and reaches the zone's redirect rule.
        { "pattern": "www.opensystemone.org", "custom_domain": true }
    ],
    "workers_dev": false,
    "preview_urls": false
}
