{
    "$schema": "node_modules/wrangler/config-schema.json",
    // The static site in dist/, served by worker.ts, which redirects www to the bare domain.
    "name": "opensystemone",
    "main": "./worker.ts",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./dist",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "binding": "ASSETS",
        // Every request reaches the Worker first, so www requests are redirected, not served.
        "run_worker_first": true
    },
    "routes": [
        { "pattern": "opensystemone.org", "custom_domain": true },
        { "pattern": "www.opensystemone.org", "custom_domain": true }
    ],
    "workers_dev": false,
    "preview_urls": false
}
