---
import '../styles/global.css';
import { REPOSITORY_URL } from '../lib/links.ts';

interface Props {
    title?: string;
    description?: string;
    frontmatter?: { title?: string; description?: string };
}

const props = Astro.props;
const title = props.title ?? props.frontmatter?.title;
const description = props.description ?? props.frontmatter?.description ??
    'An open specification for System One model APIs.';
const pageTitle = title && title !== 'Open System One' ? `${title} · Open System One` : 'Open System One';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';

const nav = [
    { label: 'Overview', href: '/' },
    { label: 'Specification', href: '/specification' },
    { label: 'Reference', href: '/reference' },
    { label: 'Adapters', href: '/adapters' },
    { label: 'Changelog', href: '/changelog' },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Open System One" />
        <meta property="og:url" content={new URL(path, Astro.site)} />
        <meta property="og:image" content={new URL('/og.png', Astro.site)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Open System One: one open contract for System One model APIs." />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="canonical" href={new URL(path, Astro.site)} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body>
        <header>
            <a class="brand" href="/"><img src="/favicon.svg" alt="" width="22" height="22" />Open System One</a>
            <a href={REPOSITORY_URL}>GitHub</a>
        </header>
        <div class="page">
            <nav aria-label="Site">
                {nav.map(item => (
                    <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
                ))}
            </nav>
            <main>
                <slot />
            </main>
        </div>
        <footer>
            <p>
                Open System One is an open specification under the
                <a href={`${REPOSITORY_URL}/blob/main/LICENSE`}>Apache-2.0 license</a>. It is independent and not
                affiliated with TypeSafe, Cloudflare, OpenAI, or Open Responses.
            </p>
        </footer>
    </body>
</html>
