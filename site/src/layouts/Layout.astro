---
import '../styles/global.css';
import { REPOSITORY_URL, SITE_URL } from '../lib/links.ts';
import { PAGES } from '../lib/pages.ts';

interface Props {
    title?: string;
    description?: string;
    frontmatter?: { title?: string; description?: string };
}

const props = Astro.props;
const title = props.title ?? props.frontmatter?.title;
const description = props.description ?? props.frontmatter?.description ??
    'An open specification for System One model APIs.';
const pageTitle = title && title !== 'Open System One' ? `${title} · Open System One` : 'Open System One';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const markdownHref = PAGES.some(page => page.href === path) ? `${path === '/' ? '/index' : path}.md` : undefined;


// Structured data for the homepage, so agents and search engines can read what the site is.
const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            name: 'Open System One',
            url: `${SITE_URL}/`,
            description,
            inLanguage: 'en',
            publisher: { '@id': `${SITE_URL}/#organization` },
        },
        {
            '@type': 'Organization',
            '@id': `${SITE_URL}/#organization`,
            name: 'Open System One',
            url: `${SITE_URL}/`,
            description: 'Maintains Open System One, an open specification for System One model APIs.',
            logo: `${SITE_URL}/favicon.svg`,
            sameAs: [REPOSITORY_URL, 'https://github.com/opensystemoneorg'],
        },
        {
            '@type': 'TechArticle',
            headline: 'Open System One',
            url: `${SITE_URL}/`,
            description,
            about: 'System One model APIs',
            keywords: 'Open System One, System One models, System One API, OpenAPI specification, structured model answers',
            license: `${REPOSITORY_URL}/blob/main/LICENSE`,
            publisher: { '@id': `${SITE_URL}/#organization` },
        },
        {
            '@type': 'SoftwareSourceCode',
            name: 'Open System One',
            description: 'The specification source: SPEC.md and the dated OpenAPI releases.',
            codeRepository: REPOSITORY_URL,
            programmingLanguage: 'OpenAPI',
            license: `${REPOSITORY_URL}/blob/main/LICENSE`,
            publisher: { '@id': `${SITE_URL}/#organization` },
        },
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Open System One" />
        <meta property="og:url" content={new URL(path, Astro.site)} />
        <meta property="og:image" content={new URL('/og.png', Astro.site)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Open System One: one open contract for System One model APIs." />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="canonical" href={new URL(path, Astro.site)} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
        {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    </head>
    <body>
        <header>
            <a class="brand" href="/"><img src="/favicon.svg" alt="" width="22" height="22" />Open System One</a>
            <a class="github" href={REPOSITORY_URL} aria-label="GitHub">
                <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" fill="currentColor">
                    <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
                </svg>
                <span>GitHub</span>
            </a>
        </header>
        <div class="page">
            <nav aria-label="Site">
                {PAGES.map(item => (
                    <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
                ))}
            </nav>
            <main>
                <slot />
            </main>
        </div>
        <footer>
            <p>
                Open System One is an open specification under the <a href={`${REPOSITORY_URL}/blob/main/LICENSE`}>Apache-2.0 license</a>.
                It is independent and not affiliated with TypeSafe, Cloudflare, OpenAI, Google, or Open Responses.
            </p>
        </footer>
    </body>
</html>
