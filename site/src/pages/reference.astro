---
import Layout from '../layouts/Layout.astro';
import { typeLabel } from '../lib/schema.ts';
import { latestRelease as latest } from '../lib/releases.ts';

const version = latest.info.version;
const schemas = Object.entries(latest.components.schemas);
---

<Layout title="Reference" description={`The schemas of the Open System One ${version} release.`}>
    <h1>Reference</h1>
    <p>
        The schemas of the <strong>{version}</strong> release.
        Download it as <a href={`/openapi/${version}.json`}>openapi/{version}.json</a>,
        or see the <a href="/openapi/draft.json">working draft</a>.
    </p>
    {schemas.map(([name, schema]) => (
        <section>
            <h3 id={name}>{name}</h3>
            {schema.description && <p>{schema.description}</p>}
            {schema.properties ? (
                <table>
                    <thead>
                        <tr><th>Property</th><th>Type</th><th>Required</th><th>Description</th></tr>
                    </thead>
                    <tbody>
                        {Object.entries(schema.properties).map(([property, value]) => (
                            <tr>
                                <td><code>{property}</code></td>
                                <td set:html={typeLabel(value)} />
                                <td>{schema.required?.includes(property) ? 'yes' : ''}</td>
                                <td>{value.description ?? ''}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            ) : (
                <p>Type: <span set:html={typeLabel(schema)} /></p>
            )}
        </section>
    ))}
</Layout>
